# Settings for docker-compose.yml. Copy this file to .env, fill it in, then run: docker compose up -d --build
# (or docker compose up -d with a release's docker-compose.yml, which runs the published images)
# .env is git-ignored; keep it private, it holds the owner's password. See docs/deploy.md for every setting.

# The site owner's account, made on the first start (required). Sign in with it to open the admin panel at /admin.
# Changing RF_OWNER_PASSWORD and restarting resets the owner's password; a password changed in the game stays until then.
RF_OWNER_NAME=Owner
RF_OWNER_EMAIL=you@example.com
RF_OWNER_PASSWORD=change-me-please

# Host port (or address:port) for the game.
RF_PORT=8080

# Only with the published images (a release's docker-compose.yml, or docker-compose.images.yml): the version to run.
# Leave it unset to run the version the compose file names; latest follows the newest release.
# RF_VERSION=0.2.0

# Public site with HTTPS (docker compose --profile https up -d): uncomment these.
# RF_DOMAIN=returnfire.example.com
# RF_TRUST_PROXY=1
# RF_PORT=127.0.0.1:8080

# Optional.
# RF_BACKUP_HOURS=24
# RF_BACKUP_KEEP=7
# RF_METRICS_TOKEN=
